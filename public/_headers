# Cloudflare Pages 响应头策略
# 规则按顺序应用，越靠后的规则覆盖越靠前的同名字段

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://static.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' https://hf-mirror.com https://cdn.jsdelivr.net https://cloudflareinsights.com https://text.pollinations.ai; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate

# 构建产物文件名含内容哈希，内容一变文件名就变，可永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 词库 JSON：文件名固定，当天内命中缓存即可，隔天回源校验保证内容更新
/data/*
  Cache-Control: public, max-age=86400

# Service Worker 及相关脚本必须每次回源校验
# 否则浏览器会长期命中旧 SW，导致发版后用户看不到更新
/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
