{
  "name": "e-learning-english",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "esbuild tests/smoke.entry.js --bundle --platform=node --format=cjs --outfile=tests/smoke.bundle.cjs --log-level=error && node tests/smoke.bundle.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:sync": "esbuild tests/sync.check.mjs --bundle --platform=node --format=cjs --outfile=tests/sync.check.cjs --log-level=error && node tests/sync.check.cjs",
    "lint": "eslint .",
    "deploy:cf": "npm run build && npx wrangler pages deploy dist --project-name=e-learning-english"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "jsqr": "^1.4.0",
    "phonemizer": "^1.2.1",
    "pinia": "^3.0.1",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "puppeteer-core": "^25.17.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
